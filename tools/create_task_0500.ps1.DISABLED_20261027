# Tao task DailyMetrics0500 — chay tools\daily_parallel.py --scheduled moi ngay 05:00
# (DA LUONG: mo 3-4 profile cung luc — anh chot 2026-10-20; nhip nguoi that trong tools\human_pace.py)
# Interactive (can GUI de mo Chrome/GPM) + StartWhenAvailable + khong dung khi pin yeu.

$ErrorActionPreference = 'Stop'
$root = 'E:\CLAUDE\YOUTUBE\PHAN_TICH_TOI_UU_VIDEO'
$pyw  = 'C:\Users\xxx\AppData\Local\Programs\Python\Python313\pythonw.exe'
$script = Join-Path $root 'tools\daily_parallel.py'

if (-not (Test-Path $pyw))    { throw "Khong thay pythonw: $pyw" }
if (-not (Test-Path $script)) { throw "Khong thay script: $script" }

$action = New-ScheduledTaskAction -Execute $pyw `
    -Argument "`"$script`" --scheduled --workers 3" `
    -WorkingDirectory $root

$trigger = New-ScheduledTaskTrigger -Daily -At '05:00'

$settings = New-ScheduledTaskSettingsSet `
    -StartWhenAvailable `
    -DontStopIfGoingOnBatteries `
    -AllowStartIfOnBatteries `
    -ExecutionTimeLimit (New-TimeSpan -Hours 2) `
    -MultipleInstances IgnoreNew `
    -RestartCount 2 `
    -RestartInterval (New-TimeSpan -Minutes 15)

# Interactive: can phien dang nhap de mo duoc cua so Chrome/GPM
$principal = New-ScheduledTaskPrincipal -UserId "$env:USERDOMAIN\$env:USERNAME" `
    -LogonType Interactive -RunLevel Limited

Register-ScheduledTask -TaskName 'DailyMetrics0500' `
    -Action $action -Trigger $trigger -Settings $settings -Principal $principal `
    -Description 'Doc YouTube Studio -> ghi N-S, cot K, to vang, TONGHOP cho 14 tab lane (khong dung LLM, khong ton token)' `
    -Force | Out-Null

Write-Output 'DA TAO task DailyMetrics0500'
Get-ScheduledTask -TaskName 'DailyMetrics0500' | Select-Object TaskName, State | Format-List
(Get-ScheduledTaskInfo -TaskName 'DailyMetrics0500') | Select-Object NextRunTime, LastRunTime, LastTaskResult | Format-List
